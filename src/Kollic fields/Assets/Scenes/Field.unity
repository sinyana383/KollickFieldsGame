  m_Name: 
  m_EditorClassIdentifier: 
  typewriterEffect: {fileID: 0}
  texts:
  - "25 \u043D\u043E\u044F\u0431\u0440\u044F \u0432\u0431\u043B\u0438\u0437\u0438
    \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u041A\u043E\u043B\u0438\u0446\u0430
    \u041C\u0430\u0433\u043D\u0438\u0442\u043E\u0448\u0430\u0445\u0442\u0438\u043D\u0441\u043A\u043E\u0439
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0431\u044B\u043B \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D
    \u0441\u043B\u0443\u0447\u0430\u0439 \u0431\u0435\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u044F \u0442\u0440\u0451\u0445
    \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u0436\u0438\u0442\u0435\u043B\u0435\u0439.
    \u041F\u043E \u0434\u0430\u043D\u043D\u044B\u043C \u043F\u0440\u0430\u0432\u043E\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043E\u0440\u0433\u0430\u043D\u043E\u0432, \u043E\u043A\u043E\u043B\u043E 6
    \u0447\u0430\u0441\u043E\u0432 \u0432\u0435\u0447\u0435\u0440\u0430 \u043C\u043E\u043B\u043E\u0434\u044B\u0435
    \u043B\u044E\u0434\u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
    \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u043B\u0435\u0441\u0430,
    \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0441 \u0446\u0435\u043B\u044C\u044E \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438
    \u0434\u0440\u043E\u0432, \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E
    \u0434\u043E\u043C\u043E\u0439 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C."
